# MML Productivity — environment overrides
#
# Copy to .env (which is .gitignore'd) and set anything you want to override
# from the sidecar's config.py defaults. The sidecar doesn't auto-load .env;
# either source it before launching the sidecar, or set these vars in your
# launchd plist (see services/mml-classifier/launchd/com.mml.classifier.template.plist).

# ---- Paths ------------------------------------------------------------------
# Defaults: warehouse.sqlite and contacts_to_rate.csv live at the repo root
# (computed from services/mml-classifier/mml_classifier/config.py).
# Override these only if you keep them elsewhere.
# MML_CLASSIFIER_WAREHOUSE_DB=/absolute/path/to/warehouse.sqlite
# MML_CLASSIFIER_CONTACTS_CSV=/absolute/path/to/contacts_to_rate.csv

# ---- HTTP server -----------------------------------------------------------
# Default: 127.0.0.1:8765. The plugin hardcodes this — change both sides if
# you change it.
# MML_CLASSIFIER_HOST=127.0.0.1
# MML_CLASSIFIER_PORT=8765

# ---- LLM CLI ---------------------------------------------------------------
# Default: 'claude' on PATH. Set to absolute path if not in PATH (launchd's
# PATH is minimal).
# MML_CLASSIFIER_CLAUDE_CLI=/absolute/path/to/claude
# MML_CLASSIFIER_CLAUDE_MODEL=haiku
# MML_CLASSIFIER_CLAUDE_TIMEOUT=120
# MML_CLASSIFIER_CLAUDE_MAX_RETRIES=3

# ---- Scoring thresholds ----------------------------------------------------
# Below this, TLDR is not generated (saves tokens).
# MML_CLASSIFIER_TLDR_THRESHOLD=0.6

# Body truncation — keeps prompts cheap and avoids CLI arg/stdin limits.
# MML_CLASSIFIER_BODY_MAX_CHARS=8000

# ---- Owner identity (optional, for pipeline scripts) -----------------------
# Path to your me_addresses.txt file (one address per line, # comments OK).
# Pipeline scripts can read this when populating OWNER_ADDRS at runtime
# instead of hardcoding the set at the top of each script.
# OWNER_ADDRS_FILE=/absolute/path/to/me_addresses.txt
